{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metawritingecology/meta-writing-ecology/blob/main/mwe-public-surface.schema.json",
  "title": "Meta-Writing Ecology Public Surface Manifest Schema",
  "description": "Validates public-surface manifest structure and references only. It does not validate conceptual authority, relation truth, empirical validity, internal Registry status, or corpus completeness.",
  "type": "object",
  "required": [
    "schema_version",
    "canonical_repository_url",
    "canonical_entries",
    "interpretation_state_policy",
    "inference_ceiling",
    "minimum_evidence",
    "authorial_confirmation_required_for"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "canonical_repository_url": {
      "type": "string",
      "format": "uri"
    },
    "repository_status": {
      "type": "string"
    },
    "is_full_archive": {
      "type": "boolean"
    },
    "is_complete_registry": {
      "type": "boolean"
    },
    "is_internal_authority_layer": {
      "type": "boolean"
    },
    "is_complete_methodology": {
      "type": "boolean"
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": true
    },
    "primary_boundary_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_entries": {
      "type": "object",
      "required": [
        "repository_orientation",
        "summary_boundary",
        "summary_contract",
        "machine_interpretation_state",
        "machine_reading_precedence",
        "source_use",
        "relation_status",
        "ai_reading_guide"
      ],
      "properties": {
        "repository_orientation": {
          "type": "string"
        },
        "summary_boundary": {
          "type": "string"
        },
        "summary_contract": {
          "type": "string"
        },
        "machine_interpretation_state": {
          "type": "string"
        },
        "machine_reading_precedence": {
          "type": "string"
        },
        "source_use": {
          "type": "string"
        },
        "relation_status": {
          "type": "string"
        },
        "ai_reading_guide": {
          "type": "string"
        },
        "public_document_registry": {
          "type": "string"
        },
        "public_document_schema": {
          "type": "string"
        },
        "public_metadata_context": {
          "type": "string"
        },
        "public_surface_schema": {
          "type": "string"
        },
        "public_misreading_register": {
          "type": "string"
        },
        "public_misreading_register_schema": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "navigation_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interpretation_defaults": {
      "type": "object",
      "additionalProperties": true
    },
    "interpretation_state_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "inference_ceiling": {
      "type": "object",
      "additionalProperties": true
    },
    "minimum_evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "authorial_confirmation_required_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "machine_readable_artifacts": {
      "type": "object",
      "required": [
        "document_registry",
        "document_schema",
        "public_surface_schema",
        "jsonld_context",
        "misreading_register",
        "misreading_register_schema",
        "validator"
      ],
      "properties": {
        "document_registry": {
          "type": "string"
        },
        "document_schema": {
          "type": "string"
        },
        "public_surface_schema": {
          "type": "string"
        },
        "jsonld_context": {
          "type": "string"
        },
        "misreading_register": {
          "type": "string"
        },
        "misreading_register_schema": {
          "type": "string"
        },
        "validator": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "public_document_registry": {
      "type": "object",
      "required": [
        "scope",
        "authority_ceiling",
        "complete_archive",
        "internal_registry",
        "omission_implies_nonexistence",
        "inclusion_implies_priority",
        "record_order_implies_hierarchy"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "authority_ceiling": {
          "type": "string"
        },
        "complete_archive": {
          "type": "boolean"
        },
        "internal_registry": {
          "type": "boolean"
        },
        "omission_implies_nonexistence": {
          "type": "boolean"
        },
        "inclusion_implies_priority": {
          "type": "boolean"
        },
        "record_order_implies_hierarchy": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "public_misreading_register": {
      "type": "object",
      "required": [
        "scope",
        "authority_ceiling",
        "third_party_intent_inference",
        "platform_wide_inference",
        "absence_of_entry"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "authority_ceiling": {
          "type": "string"
        },
        "third_party_intent_inference": {
          "type": "string"
        },
        "platform_wide_inference": {
          "type": "string"
        },
        "absence_of_entry": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "metadata_validation": {
      "type": "object",
      "required": [
        "validator",
        "validation_scope",
        "does_not_validate"
      ],
      "properties": {
        "validator": {
          "type": "string"
        },
        "validation_scope": {
          "type": "string"
        },
        "does_not_validate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
